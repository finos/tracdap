    <!-- CVE-2026-47874 is a memory exhaustion in the reactor-netty HTTP server (pipelined HTTP/1.1 requests).
         TRAC only uses reactor-netty as the Azure SDK's HTTP client and never runs a reactor-netty server.
         reactor-netty-core / reactor-netty-http are pulled in by the Azure SDK (azure-core-http-netty),
         which pins its own build to exactly reactor-netty 1.2.18 (enforced via a Maven banned-dependency
         rule in azure-core-http-netty's own pom). The 1.2.x fix (1.2.19) is only available with commercial
         Spring support, and forcing a newer line (1.3.x, fixed in 1.3.7) broke Azure BLOB storage round trips
         on multi-chunk uploads - see tracdap-libs/tracdap-lib-common and tracdap-lib-data build.gradle.
         Revisit when an azure-core-http-netty release moves to reactor-netty 1.3.7 or later (as of Oct 2026
         only the unreleased 1.17.0 beta does, along with Netty 4.2 and Reactor 3.8). -->
    <suppress>
        <packageUrl regex="true">^pkg:maven/io\.projectreactor\.netty/reactor\-netty\-.*@.*$</packageUrl>
        <vulnerabilityName>CVE-2026-47874</vulnerabilityName>
    </suppress>


